  <style>
    * { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
    }
    body { 
      background-color: #0f0f11; 
      color: #ffffff; 
      display: flex; 
      justify-content: center; 
      align-items: center; 
      min-height: 100vh; 
      padding: 20px 15px; 
    }
    .container { 
      width: 100%; 
      max-width: 420px; 
      background: #18181c; 
      border-radius: 20px; 
      border: 1px solid #2a2a32; 
      box-shadow: 0 10px 30px rgba(0,0,0,0.5); 
      padding: 25px 20px; 
      text-align: center; 
    }
    .top-alert { 
      background: rgba(220, 53, 69, 0.15); 
      border: 1px solid #dc3545; 
      color: #ff6b6b; 
      padding: 10px; 
      border-radius: 10px; 
      font-size: 13px; 
      font-weight: 700; 
      text-transform: uppercase; 
      letter-spacing: 0.5px; 
      margin-bottom: 20px; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      gap: 6px; 
    }
    .logo-badge { 
      width: 80px; 
      height: 80px; 
      margin: 0 auto 15px; 
      background: linear-gradient(135deg, #ffd700 0%, #b8860b 100%); 
      border-radius: 20px; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      box-shadow: 0 8px 20px rgba(255, 215, 0, 0.25); 
    }
    .logo-badge svg { 
      width: 45px; 
      height: 45px; 
      fill: #0f0f11; 
    }
    h1 { 
      font-size: 26px; 
      font-weight: 800; 
      color: #ffffff; 
      margin-bottom: 4px; 
      letter-spacing: 0.5px; 
    }
    .subtitle { 
      font-size: 13px; 
      color: #ffd700; 
      font-weight: 700; 
      text-transform: uppercase; 
      letter-spacing: 1.5px; 
      margin-bottom: 15px; 
    }
    .description { 
      font-size: 14px; 
      color: #a0a0ab; 
      line-height: 1.5; 
      margin-bottom: 22px; 
    }
    .timer-box { 
      background: #0f0f11; 
      border: 1px solid #2a2a32; 
      border-radius: 12px; 
      padding: 12px; 
      margin-bottom: 20px; 
    }
    .timer-title { 
      font-size: 12px; 
      color: #80808c; 
      text-transform: uppercase; 
      margin-bottom: 6px; 
      font-weight: 600; 
    }
    .timer { 
      font-size: 28px; 
      font-weight: 800; 
      color: #ff4757; 
      letter-spacing: 2px; 
    }
    .progress-section { 
      margin-bottom: 25px; 
    }
    .progress-info { 
      display: flex; 
      justify-content: space-between; 
      font-size: 12px; 
      color: #a0a0ab; 
      margin-bottom: 6px; 
      font-weight: 600; 
    }
    .progress-bar-bg { 
      width: 100%; 
      height: 10px; 
      background: #2a2a32; 
      border-radius: 5px; 
      overflow: hidden; 
    }
    .progress-bar-fill { 
      width: 94%; 
      height: 100%; 
      background: linear-gradient(90deg, #ff4757, #ffa502); 
      border-radius: 5px; 
    }
    .btn { 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      gap: 10px; 
      width: 100%; 
      padding: 16px; 
      border-radius: 14px; 
      text-decoration: none; 
      font-weight: 700; 
      font-size: 15px; 
      margin-bottom: 12px; 
      transition: transform 0.2s; 
      box-shadow: 0 4px 15px rgba(0,0,0,0.3); 
    }
    .btn:active { 
      transform: scale(0.98); 
    }
    .btn-wa { 
      background: #25d366; 
      color: #ffffff; 
    }
    .btn-tg { 
      background: #0088cc; 
      color: #ffffff; 
    }
    .btn svg { 
      width: 22px; 
      height: 22px; 
      fill: currentColor; 
    }
    .footer-note { 
      font-size: 11px; 
      color: #60606a; 
      margin-top: 15px; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      gap: 5px; 
    }
  </style>
</head>
<body>
